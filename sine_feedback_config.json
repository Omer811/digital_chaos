{
  "arduino": {
    "fqbn": "arduino:avr:uno",
    "port": "/dev/cu.usbmodem1201",
    "baud_rate": 115200,
    "upload_before_run": true,
    "sketch_path": "arduino/sine_feedback"
  },
  "experiment": {
    "steps": 1000,
    "sine_samples_per_cycle": 1000,
    "time_slices": 1,
    "max_samples": 100000,
    "stop_when_decay": false,
    "decay_threshold_norm": 0.02,
    "decay_metric": "peak_to_peak",
    "min_slices_before_decay_check": 5,
    "pwm_pin": 9,
    "analog_pin": 0,
    "settle_us": 2000,
    "oversample_count": 16,
    "oversample_delay_us": 50,
    "alpha_permille": 650,
    "progress_every_steps": 100,
    "serial_timeout_seconds": 25,
    "handshake_timeout_seconds": 5
  },
  "output": {
    "dir": "output/sine_feedback",
    "csv": "sine_feedback_steps.csv",
    "plot_2d_png": "sine_feedback_2d.png",
    "plot_2d_html": "sine_feedback_2d.html",
    "plot_3d_png": "sine_feedback_3d.png",
    "plot_3d_html": "sine_feedback_3d.html"
  }
}
